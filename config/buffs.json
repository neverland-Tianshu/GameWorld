    "countAsLayer": false,
    "conditions": [
     {
      "type": "compareRef",
      "left": {
       "ref": "buff.data.shield"
      },
      "op": ">",
      "val": 0
     }
    ],
    "actions": [
     {
      "type": "modifyValue",
      "op": "absorb",
      "scope": "buff",
      "varName": "shield",

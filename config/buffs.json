 "wisdom": {
  "id": "wisdom",
  "name": "智慧守护",
  "kind": "wisdom",
  "duration": 99,
  "permanent": true,
  "color": "#8ed6ff",
  "_note": "天赋被动（宠物/怪物）：受击时先按比例减伤，再把一部分伤害转由 MP 承担；自身回合开始消耗寿命。参数由技能 184400 的 dataFormula 写入 data：{level, reducePct, mpShareFrac, mpShareFracLow, lifeCost}。BEFORE_DAMAGE 流水序：① cutPct 减伤 → ② 取分担比例(高) → ③ 算分担量 → ④ MP 不足则改用低比例重算 → ⑤ 实际承担量=min(分担量, 当前MP) → ⑥ 伤害扣除该量并扣蓝飘字。永久 buff：不随回合过期（fighter.addBuff/tickBuffs 的 permanent 守卫）。",
  "triggers": [
   {
    "event": "BEFORE_DAMAGE",
    "filter": "self",
    "priority": 30,
    "countAsLayer": false,
    "conditions": [
     {
      "type": "compareRef",
      "left": {
       "ref": "event.value"
      },
      "op": ">",
      "val": 0
     }
    ],
    "actions": [
     {
      "type": "modifyValue",
      "op": "cutPct",
      "pct": {
       "ref": "buff.data.reducePct"
      },
      "max": {
       "ref": "event.value"
      }
     },
     {
      "type": "modifyVar",
      "scope": "buff",
      "varName": "__frac",
      "op": "set",
      "from": {
       "ref": "buff.data.mpShareFrac"
      }
     },
     {
      "type": "modifyVar",
      "scope": "buff",
      "varName": "__share",
      "op": "set",
      "scaleFrom": "eventValue",
      "coef": {
       "ref": "buffVar.__frac"
      }
     },
     {
      "type": "modifyVar",
      "scope": "buff",
      "varName": "__frac",
      "op": "set",
      "from": {
       "ref": "buff.data.mpShareFracLow"
      },
      "conditions": [
       {
        "type": "compareRef",
        "left": {
         "ref": "self.mp"
        },
        "op": "<",
        "val": {
         "ref": "buffVar.__share"
        }
       }
      ]
     },
     {
      "type": "modifyVar",
      "scope": "buff",
      "varName": "__share",
      "op": "set",
      "scaleFrom": "eventValue",
      "coef": {
       "ref": "buffVar.__frac"
      },
      "conditions": [
       {
        "type": "compareRef",
        "left": {
         "ref": "self.mp"
        },
        "op": "<",
        "val": {
         "ref": "buffVar.__share"
        }
       }
      ]
     },
     {
      "type": "modifyVar",
      "scope": "buff",
      "varName": "__pay",
      "op": "set",
      "from": {
       "ref": "buffVar.__share"
      },
      "conditions": [
       {
        "type": "compareRef",
        "left": {
         "ref": "self.mp"
        },
        "op": ">=",
        "val": {
         "ref": "buffVar.__share"
        }
       }
      ]
     },
     {
      "type": "modifyVar",
      "scope": "buff",
      "varName": "__pay",
      "op": "set",
      "from": {
       "ref": "self.mp"
      },
      "conditions": [
       {
        "type": "compareRef",
        "left": {
         "ref": "self.mp"
        },
        "op": "<",
        "val": {
         "ref": "buffVar.__share"
        }
       }
      ]
     },
     {
      "type": "modifyValue",
      "op": "sub",
      "value": {
       "ref": "buffVar.__pay"
      },
      "conditions": [
       {
        "type": "compareRef",
        "left": {
         "ref": "self.mp"
        },
        "op": ">",
        "val": 0
       }
      ]
     },
     {
      "type": "resource",
      "targetMode": "self",
      "mpCost": {
       "ref": "buffVar.__pay"
      },
      "conditions": [
       {
        "type": "compareVar",
        "scope": "buff",
        "varName": "__pay",
        "op": ">",
        "val": 0
       }
      ]
     },
     {
      "type": "floatNum",
      "targetMode": "self",
      "text": "-{buffVar.__pay} 蓝",
      "color": "#7fbfff",
      "conditions": [
       {
        "type": "compareVar",
        "scope": "buff",
        "varName": "__pay",
        "op": ">",
        "val": 0
       }
      ]
     },
     {
      "type": "log",
      "text": "{target} 【{buff}】法力抵消 {buffVar.__pay} 点伤害（自身承 {value}）",
      "conditions": [
       {
        "type": "compareVar",
        "scope": "buff",
        "varName": "__pay",
        "op": ">",
        "val": 0
       }
      ]
     }
    ]
   },
   {
    "event": "TURN_START",
    "filter": "self",
    "countAsLayer": false,
    "actions": [
     {
      "type": "resource",
      "targetMode": "self",
      "lifeCost": {
       "ref": "buff.data.lifeCost"
      },
      "conditions": [
       {
        "type": "compareRef",
        "left": {
         "ref": "buff.data.lifeCost"
        },
        "op": ">",
        "val": 0
       }
      ]
     }
    ]
   }
  ]
 },

const grid = document.getElementById('grid');
const countEl = document.getElementById('count');
const filterEl = document.getElementById('filter');
const toggleBtn = document.getElementById('toggle');

const MAX_LOADS = 16;          // 并发加载上限
let loading = 0;
const loadQueue = [];
let io = null;
let globalPaused = false;     // 全局暂停开关（默认 false = 可见即播放）
const swfCache = {};           // id -> { text, blobMap }  blobMap 值带 '#.png' 后缀；保留不释放

function parseSwf(text){ return new Function(text + "\n;return swfData;")(); }

function deepReplace(obj, map){
  if (Array.isArray(obj)){
    for (let i=0;i<obj.length;i++){
      if (typeof obj[i]==='string' && map[obj[i]]) obj[i]=map[obj[i]];
      else if (obj[i] && typeof obj[i]==='object') deepReplace(obj[i], map);
    }
  } else if (obj && typeof obj==='object'){
    for (const k in obj){
      if (typeof obj[k]==='string' && map[obj[k]]) obj[k]=map[obj[k]];
      else if (obj[k] && typeof obj[k]==='object') deepReplace(obj[k], map);
    }
  }
}

function fail(card){ card._state='idle'; card.classList.remove('loading'); }

/* ═══════════ 并集合围盒 + 锚点（与角色模型总画廊同源）═══════════
   精灵是单池特效精灵，脚点/锚点 = Flash 原点 (0,0)（与技能/特效「原点对齐落点」同源）；
   仅当根时间轴在 (-256,-256) 放置精灵时才取 (256,256)。 */
function mergeRect(a, b){
  if (!a) return b; if (!b) return a;
  const x = Math.min(a.x, b.x), y = Math.min(a.y, b.y);
  return { x, y, width: Math.max(a.x+a.width, b.x+b.width)-x, height: Math.max(a.y+a.height, b.y+b.height)-y };
}
function unionRectOf(dp, idx, seen){
  seen = seen || new Set();
  if (seen.has(idx)) return null;
  seen.add(idx);
  const d = dp[idx]; if (!d) return null;
  let r = (d.rect && (d.rect.width || d.rect.height)) ? { x:d.rect.x, y:d.rect.y, width:d.rect.width, height:d.rect.height } : null;
  const fal = d.frameActionList;
  if (fal && Array.isArray(fal)) for (const kf of fal) {
    if (!kf) continue; const acts = Array.isArray(kf) ? kf.slice(1) : [];
    for (const a of acts) if (Array.isArray(a) && a[0]==='pE' && a[1] && a[1].id != null) r = mergeRect(r, unionRectOf(dp, a[1].id, seen));
  }
  const dl = d.displayList || d.frames;
  if (dl && Array.isArray(dl)) for (const fr of dl) {
    if (!Array.isArray(fr)) continue;
    for (const a of fr) if (Array.isArray(a) && a[0]==='pE' && a[1] && a[1].id != null) r = mergeRect(r, unionRectOf(dp, a[1].id, seen));
  }
  return r;
}
function topLevelPlaceLocal(swf){
  const dp = swf && swf.definitionPool;
  const d0 = dp && dp[0]; if (!d0) return null;
  const lists = [];
  if (Array.isArray(d0.frameActionList)) lists.push(d0.frameActionList);
  const dl = d0.displayList || d0.frames; if (Array.isArray(dl)) lists.push(dl);
  for (const list of lists) for (const fr of list) {
    if (!Array.isArray(fr)) continue;
    for (const a of fr) if (Array.isArray(a) && a[0] === 'pE' && a[1] && a[1].id != null) {
      const m = a[1].m || a[1].matrix;
      return { x: (a[1].x != null ? a[1].x : (Array.isArray(m) ? m[4] : 0)) || 0,
               y: (a[1].y != null ? a[1].y : (Array.isArray(m) ? m[5] : 0)) || 0 };
    }
  }
  return null;
}
function resolveFootForSprite(id, swf, renderRect){
  const pl = topLevelPlaceLocal(swf);
  if (pl && pl.x === -256 && pl.y === -256) return { x: 256, y: 256, src: 'rootPlace' };
  return { x: 0, y: 0, src: 'roleOrigin' };
}
const DIR_MIRROR = { RB:false, LB:true, LT:false, RT:true };

function clearStage(box){
  const cvs = box.querySelectorAll('canvas');
  for (let i = 0; i < cvs.length; i++) { try { fanvas.pause(cvs[i].id); } catch (e) {} }
  while (box.firstChild) box.removeChild(box.firstChild);
}
function placeCanvas(cv, rect, box, stageW, stageH){
  const k = Math.min(stageW / box.w, stageH / box.h);
  let cssW, cssH, left, top;
  if (rect && rect.width > 0) {
    cssW = rect.width * k; cssH = rect.height * k;
    left = (stageW - box.w*k)/2 + (rect.x - box.x)*k;
    top  = (stageH - box.h*k)/2 + (rect.y - box.y)*k;
  } else {
    const s = Math.min(stageW / (cv.width||1), stageH / (cv.height||1));
    cssW = (cv.width||0)*s; cssH = (cv.height||0)*s;
    left = (stageW - cssW)/2; top = (stageH - cssH)/2;
  }
  cv.style.width = cssW + 'px'; cv.style.height = cssH + 'px';
  cv.style.left = left + 'px'; cv.style.top = top + 'px';
  return { k, left, top, cssW, cssH };
}
// 翻转轴 = 锚点(原点=脚点，红十字)。精灵脚点=(0,0) 多在 rect 之外，绕脚点翻转会把可见内容镜像到另一侧、
// 偏出 stage 被 overflow:hidden 裁掉；故把 canvas 的 layout left 设为「让镜像后的可见包围盒居中于 stage」。
function applyMirrorOrigin(cv, mirror, rect, box, pos, id, swf){
  if (!mirror) { cv.style.transform = 'none'; return; }
  if (!rect || !(rect.width > 0)) { cv.style.transformOrigin = 'center center'; cv.style.transform = 'scaleX(-1)'; return; }
  const f = resolveFootForSprite(id, swf, rect);
  const ox = (f.x - rect.x) * pos.k;
  const cssW = rect.width * pos.k;
  const stageW = cv.parentElement ? cv.parentElement.clientWidth : 0;
  if (stageW) cv.style.left = (stageW / 2 - 2 * ox + cssW / 2) + 'px';
  cv.style.transformOrigin = ox + 'px center';
  cv.style.transform = 'scaleX(-1)';
}
const SRC_TXT = { rootPlace:'常规(根偏移-256)', roleOrigin:'精灵(Flash原点0,0)', center:'256约定', override:'标定覆盖' };
function addAnchorMarkers(stage, box, stageW, stageH, id, swf, renderRect, mirror){
  if (!(box && box.w > 0 && box.h > 0)) return;
  const k = Math.min(stageW / box.w, stageH / box.h);
  const bx = (stageW - box.w * k) / 2, by = (stageH - box.h * k) / 2;
  const f = resolveFootForSprite(id, swf, renderRect);
  let fx = bx + (f.x - box.x) * k, fy = by + (f.y - box.y) * k;
  if (mirror && renderRect && renderRect.width > 0){
    const ox = (f.x - renderRect.x) * k, cssW = renderRect.width * k;
    fx = stageW / 2 - ox + cssW / 2;
  }
  const cross = document.createElement('div'); cross.className = 'mk-origin';
  cross.style.left = fx + 'px'; cross.style.top = fy + 'px';
  stage.appendChild(cross);
  const dot = document.createElement('div'); dot.className = 'mk-foot';
  dot.style.left = fx + 'px'; dot.style.top = fy + 'px';
  stage.appendChild(dot);
  const lbl = document.createElement('div'); lbl.className = 'mk-label';
  lbl.textContent = '锚点(原点=脚点)(' + Math.round(f.x) + ',' + Math.round(f.y) + ') · ' + (SRC_TXT[f.src] || f.src);
  stage.appendChild(lbl);
}
// 在指定 stage 播放一个精灵（rootDef=main），按统一包围盒落位 + 锚标 + 可选镜像
function playSprite(stage, swf, main, mirror, id){
  clearStage(stage);
  const rect = unionRectOf(swf.definitionPool, main);
  const box = (rect && rect.width > 0 && rect.height > 0) ? { x:rect.x, y:rect.y, w:rect.width, h:rect.height } : { x:0, y:0, w:512, h:512 };
  if (rect && rect.width > 0 && rect.height > 0) swf.definitionPool[main].rect = rect;
  const cv = document.createElement('canvas');
  const cid = 'cv_' + id + '_' + Math.random().toString(36).slice(2,8);
  cv.id = cid; cv.style.display = 'block';
  stage.appendChild(cv);
  fanvas.play(cid, swf, { rootDef: main, transparent:true, cache:1, imagePath:'' });
  const stageW = stage.clientWidth, stageH = stage.clientHeight;
  const pos = placeCanvas(cv, rect, box, stageW, stageH);
  applyMirrorOrigin(cv, mirror, rect, box, pos, id, swf);
  addAnchorMarkers(stage, box, stageW, stageH, id, swf, rect, mirror);
  return { cv, cid };
}

async function loadSkill(card){
  const id = card._id;
  const myToken = ++card._token;           // 本次加载的令牌
  card._state = 'loading'; card.classList.add('loading'); loading++;
  try {
    let cache = swfCache[id];
    if (!cache){
      let text;
      try { text = await (await fetch('./' + id + '/swfData.js')).text(); }
      catch(e){ fail(card); return; }       // 网络失败：置 idle 等下次
      if (card._token !== myToken){ fail(card); return; }
      const blobMap = {};
      const swf0 = parseSwf(text);
      const imgs = swf0.images || [];
      await Promise.all(imgs.map(async nm=>{
        try {
          const buf = await (await fetch('./' + id + '/images/' + nm)).arrayBuffer();
          blobMap[nm] = URL.createObjectURL(new Blob([buf], {type:'image/png'})) + "#.png";
        } catch(e){}
      }));
      if (card._token !== myToken){          // 已失效：释放本地 blob，放弃
        for (const k in blobMap) URL.revokeObjectURL(blobMap[k].split('#')[0]);
        fail(card); return;
      }
      cache = { text, blobMap };
      swfCache[id] = cache;                   // 缓存保留，blob 永不失活
    }
    // 播放前校验：令牌有效 且 容器仍在文档中（否则 appendChild 到脱离节点会崩）
    if (card._token !== myToken || !card._stage.isConnected){ fail(card); return; }
    const swf = parseSwf(cache.text);
    deepReplace(swf, cache.blobMap);
    const main = card._main == null ? 0 : card._main;
    const r = playSprite(card._stage, swf, main, false, id);   // 卡片视图不翻转，仅显示锚标
    card._cid = r.cid; card._canvas = r.cv;
    card._state = 'ready'; card.classList.remove('loading');
    // 可见区域同时播放：进入视口且在播放态即保持动画；否则暂停（滑出/全局暂停）
    if (!(card._visible && !globalPaused)){ try{ fanvas.pause(card._cid); }catch(e){} }
  } catch(e){
    if (card._canvas){ card._canvas.remove(); card._canvas=null; }
    fail(card);
  } finally {
    loading--; pump();
  }
}

function unload(card){
  if (card._state!=='ready' && card._state!=='loading') return;
  if (card._cid){ try{ fanvas.pause(card._cid); }catch(e){} }
  clearStage(card._stage);                 // 同时清掉画布与锚标 div
  card._cid = null; card._canvas = null; card._state = 'idle';
  // 注意：不 revoke blob，避免 in-flight 加载拿到失效 blob 导致 ERR_FILE_NOT_FOUND
}

function pump(){ while(loadQueue.length && loading < MAX_LOADS) loadSkill(loadQueue.shift()); }

function makeCard(item){
  const card = document.createElement('div');
  card.className = 'card';
  card._id = item.id; card._main = item.main; card._state = 'idle'; card._token = 0; card._visible = false;
  const stage = document.createElement('div'); stage.className='stage';
  const cap = document.createElement('div'); cap.className='cap'; cap.textContent = item.id;
  card.appendChild(stage); card.appendChild(cap);
  card._stage = stage;
  card.addEventListener('click', () => openModal(item.id));   // 点击放大（含水平翻转）
  return card;
}

function build(list){
  if (io) io.disconnect();
  loadQueue.length = 0; loading = 0; globalPaused = false; toggleBtn.textContent='暂停全部';
  grid.innerHTML = '';
  io = new IntersectionObserver((entries)=>{
    entries.forEach(en=>{
      const card = en.target;
      card._visible = en.isIntersecting;
      if (en.isIntersecting){
        if (card._state==='ready'){ if(!globalPaused){ try{ fanvas.resume(card._cid); }catch(e){} } }
        else if (card._state==='idle'){ if (loading < MAX_LOADS) loadSkill(card); else loadQueue.push(card); }
      } else {
        unload(card);
        const i = loadQueue.indexOf(card); if (i>=0) loadQueue.splice(i,1);
      }
    });
  }, { rootMargin: '300px 0px' });
  list.forEach(item=>{ const card = makeCard(item); grid.appendChild(card); io.observe(card); });
  countEl.textContent = '共 ' + list.length + ' 个技能';
}

toggleBtn.addEventListener('click', ()=>{
  globalPaused = !globalPaused;
  toggleBtn.textContent = globalPaused ? '播放全部' : '暂停全部';
  Array.from(grid.children).forEach(card=>{
    if (card._state==='ready'){ try{ globalPaused ? fanvas.pause(card._cid) : fanvas.resume(card._cid); }catch(e){} }
  });
});

filterEl.addEventListener('input', ()=>{
  const q = filterEl.value.trim();
  build(q ? SKILLS.filter(x=>x.id.includes(q)) : SKILLS);
});

/* ═══════════ 点击放大 + 水平翻转 ═══════════ */
const modal = document.getElementById('modal');
const mstage = document.getElementById('mstage');
const mtitle = document.getElementById('mtitle');
const MAIN_BY_ID = {}; SKILLS.forEach(s => { MAIN_BY_ID[s.id] = s.main; });
let mId = null, mCache = null, mDir = 'RB';

async function loadCache(id){            // 与卡片共用 swfCache
  if (swfCache[id]) return swfCache[id];
  const text = await (await fetch('./' + id + '/swfData.js')).text();
  const blobMap = {};
  const swf0 = parseSwf(text);
  await Promise.all((swf0.images||[]).map(async nm=>{
    try { const buf = await (await fetch('./' + id + '/images/' + nm)).arrayBuffer();
      blobMap[nm] = URL.createObjectURL(new Blob([buf], {type:'image/png'})) + "#.png"; } catch(e){}
  }));
  const cache = { text, blobMap };
  swfCache[id] = cache;
  return cache;
}

async function openModal(id){
  mId = id; mDir = 'RB';
  Array.from(document.querySelectorAll('.mdir button')).forEach(x => x.classList.toggle('on', x.dataset.d === 'RB'));
  modal.classList.remove('hidden');
  mtitle.textContent = id + ' 加载中…';
  clearStage(mstage);
  try { mCache = await loadCache(id); } catch(e){ mtitle.textContent = id + ' 加载失败'; return; }
  renderModal();
}
function renderModal(){
  if (!mCache) return;
  const swf = parseSwf(mCache.text);
  deepReplace(swf, mCache.blobMap);
  const main = (MAIN_BY_ID[mId] != null) ? MAIN_BY_ID[mId] : 0;
  playSprite(mstage, swf, main, DIR_MIRROR[mDir], mId);
  mtitle.textContent = mId + '  ·  锚点=Flash原点(0,0)' + (DIR_MIRROR[mDir] ? '  ·  已水平翻转' : '');
}
function closeModal(){ modal.classList.add('hidden'); clearStage(mstage); mCache = null; }
document.getElementById('mclose').onclick = closeModal;
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
Array.from(document.querySelectorAll('.mdir button')).forEach(b => {
  b.onclick = () => {
    mDir = b.dataset.d;
    Array.from(document.querySelectorAll('.mdir button')).forEach(x => x.classList.toggle('on', x.dataset.d === mDir));
    renderModal();
  };
});

if (typeof fanvas === 'undefined'){
  grid.innerHTML = '<p style="color:#f99;padding:20px">fanvas 库未加载：必须从 GameWorld 目录起本地服务器（见顶部说明），直接双击打开会因路径问题失败。</p>';
} else {
  build(SKILLS);
}
</script>
</body>
</html>
